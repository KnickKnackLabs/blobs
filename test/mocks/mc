#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >> "${S3_TEST_DIR}/requests.log"
command="${1}"
shift

if [[ "${command}" == "alias" ]]; then
  case "$*" in
    "list test")
      cat "${S3_TEST_DIR}/alias"
      ;;

    "list test --json")
      if [[ -s "${S3_TEST_DIR}/alias" ]]; then
        printf '%s\n' \
          '{"URL":"https://s3.example.test","accessKey":"fictional-key-id"}'
      fi
      ;;

    "set "*) ;;

    *)
      echo "Unexpected mock alias request: $*" >&2
      exit 1
      ;;
  esac

  exit 0
fi

if [[ -f "${S3_TEST_DIR}/request-fails" ]]; then
  echo "mc: simulated request failure" >&2
  exit 1
fi

case "${command}" in
  stat)
    printf '%s\n' \
      '{"etag":"fictional-etag","versionID":"fictional-version"}'
    ;;

  cat)
    cat "${S3_TEST_DIR}/responses/download"
    ;;

  cp)
    [[ "${1}" != "-q" ]] || shift

    source="${1}"
    destination="${2}"

    if [[ "${source}" == test/test-bucket/* ]]; then
      cp "${S3_TEST_DIR}/responses/download" "${destination}"
    else
      cp "${source}" "${S3_TEST_DIR}/upload"
    fi
    ;;

  pipe)
    cat > "${S3_TEST_DIR}/upload"
    ;;

  ls)
    format=txt
    listing=list

    while [[ "${1}" == --* ]]; do
      case "${1}" in
        --json)
          format=jsonl
          ;;

        --recursive)
          listing=list-recursive
          ;;

        *)
          echo "Unexpected mc listing flag: ${1}" >&2
          exit 1
          ;;
      esac

      shift
    done

    directory="${1#test/test-bucket}"
    directory="${directory%/}"

    cat \
      "${S3_TEST_DIR}/responses${directory}/${listing}.${format}"
    ;;

  rm) ;;

  *) echo "Unexpected mc command: ${command}" >&2; exit 1 ;;
esac
